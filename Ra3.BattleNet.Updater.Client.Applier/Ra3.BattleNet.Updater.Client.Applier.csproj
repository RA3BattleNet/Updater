<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Native AOT / 裁剪：让分析器在本仓库就把反射式 JSON、动态代码这类问题拦下来（要求零告警） -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ra3.BattleNet.Updater.Applier</RootNamespace>
    <!-- 产物名与承载目录里的名字一致：applier_bin/{RID}/Client.Applier.exe -->
    <AssemblyName>Client.Applier</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ra3.BattleNet.Updater.Client\Ra3.BattleNet.Updater.Client.csproj" />
  </ItemGroup>

</Project>